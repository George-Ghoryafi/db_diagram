{
  "name": "local-dbdiagram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsx scripts/generate-example.ts && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "mcp": "tsx server/mcp.ts"
  },
  "dependencies": {
    "@codemirror/lang-sql": "latest",
    "@codemirror/language": "latest",
    "@codemirror/legacy-modes": "latest",
    "@codemirror/view": "^6.43.14",
    "@dbml/core": "latest",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "latest",
    "@neondatabase/serverless": "1.2.0",
    "@uiw/react-codemirror": "latest",
    "@xyflow/react": "latest",
    "elkjs": "^0.12.0",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
